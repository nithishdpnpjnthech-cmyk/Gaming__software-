{
  "Agent": {
    "DisplayName": "GamingStation",
    "AutoStart": true,
    "RunInBackground": true,
    "Environment": "Production"
  },
  "Server": {
    "ServerIp": "192.168.29.56",
    "ApiPort": 5022,
    "WebSocketPort": 5022,
    "WebSocketPath": "/hubs/agent",
    "UseSecureConnection": true
  },
  "Backend": {
    "ApiBaseUrl": "https://192.168.29.56:5022",
    "HubUrl": "https://192.168.29.56:5022/hubs/agent",
    "EnableSignalR": true,
    "RequireWss": true,
    "ValidateCertificates": true,
    "ExpectedCertificateThumbprint": "",
    "ConnectionTimeoutSeconds": 30,
    "HandshakeTimeoutSeconds": 15,
    "HttpTimeoutSeconds": 15
  },
  "Connection": {
    "EnableSignalR": true,
    "HeartbeatIntervalSeconds": 5,
    "ConnectionTimeoutSeconds": 30,
    "ReconnectEnabled": true,
    "MaximumReconnectDelaySeconds": 60
  },
  "Security": {
    "UseMachineScope": true,
    "RejectNonWss": true
  },
  "Reconnection": {
    "InitialDelaySeconds": 2.0,
    "MaxDelaySeconds": 60.0,
    "BackoffMultiplier": 2.0,
    "JitterMaxSeconds": 3.0,
    "MaxReconnectAttempts": 0
  },
  "Heartbeat": {
    "IntervalSeconds": 5,
    "TimeoutSeconds": 10,
    "MaxMissedHeartbeats": 3
  },
  "Identity": {
    "StorageDirectory": "data",
    "ClientVersion": "1.0.0"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.SignalR": "Warning"
    },
    "File": {
      "LogDirectory": "logs",
      "MaxFileSizeMb": 10,
      "RetainedFileDays": 14
    }
  }
}