{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Information",
      "Microsoft.AspNetCore.SignalR.Client": "Debug"
    }
  },
  "GamingCafeAgent": {
    "BackendApiBaseUrl": "https://127.0.0.1:5001",
    "SignalRHubUrl": "https://127.0.0.1:5001/hubs/agent",
    "HeartbeatIntervalSeconds": 10,
    "HttpTimeoutSeconds": 5,
    "SignalRConnectionTimeoutSeconds": 10,
    "EnrollmentPollIntervalSeconds": 5,
    "MinRetryBackoffSeconds": 1,
    "MaxRetryBackoffSeconds": 10,
    "BackoffJitterFactor": 0.1,
    "AgentVersion": "1.0.0-phase1-dev",
    "ProtocolVersion": "1.0",
    "LocalDataDirectory": "./dev_data",
    "EnvironmentName": "Development",
    "TlsValidationMode": "SystemTrust",
    "PinnedCertificateThumbprint": ""
  }
}
