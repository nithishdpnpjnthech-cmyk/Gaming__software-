{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.SignalR": "Information"
    },
    "File": {
      "LogDirectory": "logs-dev",
      "MaxFileSizeMb": 5,
      "RetainedFileDays": 7
    }
  },
  "Backend": {
    "ApiBaseUrl": "http://localhost:5022",
    "HubUrl": "wss://localhost:5001/hubs/agent",
    "EnableSignalR": false,
    "RequireWss": true,
    "ValidateCertificates": true,
    "ExpectedCertificateThumbprint": "C1F90C7F1D251AE7212902B38A2FF60F994F1BFF",
    "ConnectionTimeoutSeconds": 15,
    "HandshakeTimeoutSeconds": 10,
    "HttpTimeoutSeconds": 10
  },
  "Reconnection": {
    "InitialDelaySeconds": 1,
    "MaxDelaySeconds": 15,
    "BackoffMultiplier": 1.5,
    "JitterMaxSeconds": 1,
    "MaxReconnectAttempts": 0
  },
  "Heartbeat": {
    "IntervalSeconds": 10,
    "TimeoutSeconds": 5,
    "MaxMissedHeartbeats": 3
  },
  "Identity": {
    "StorageDirectory": "data",
    "ClientVersion": "1.0.0-dev"
  },
  "Security": {
    "UseMachineScope": false,
    "RejectNonWss": true
  }
}
