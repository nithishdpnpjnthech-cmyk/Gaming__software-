{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.SignalR": "Warning"
    },
    "File": {
      "LogDirectory": "logs",
      "MaxFileSizeMb": 10,
      "RetainedFileDays": 14
    }
  },
  "Backend": {
    "ApiBaseUrl": "http://localhost:5022",
    "HubUrl": "http://localhost:5022/hubs/agent",
    "EnableSignalR": true,
    "RequireWss": false,
    "ValidateCertificates": false,
    "ExpectedCertificateThumbprint": "",
    "ConnectionTimeoutSeconds": 30,
    "HandshakeTimeoutSeconds": 15,
    "HttpTimeoutSeconds": 15
  },
  "Security": {
    "UseMachineScope": false,
    "RejectNonWss": false
  },
  "Reconnection": {
    "InitialDelaySeconds": 2,
    "MaxDelaySeconds": 60,
    "BackoffMultiplier": 2.0,
    "JitterMaxSeconds": 3,
    "MaxReconnectAttempts": 0
  },
  "Heartbeat": {
    "IntervalSeconds": 3,
    "TimeoutSeconds": 2,
    "MaxMissedHeartbeats": 3
  },
  "Identity": {
    "StorageDirectory": "data",
    "ClientVersion": "1.0.0"
  }
}
