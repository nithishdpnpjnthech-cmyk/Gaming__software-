{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.AspNetCore.SignalR.Client": "Information"
    }
  },
  "GamingCafeAgent": {
    "BackendApiBaseUrl": "https://admin.gamingcafe.lan:5001",
    "SignalRHubUrl": "https://admin.gamingcafe.lan:5001/hubs/agent",
    "HeartbeatIntervalSeconds": 30,
    "HttpTimeoutSeconds": 10,
    "SignalRConnectionTimeoutSeconds": 15,
    "EnrollmentPollIntervalSeconds": 10,
    "MinRetryBackoffSeconds": 2,
    "MaxRetryBackoffSeconds": 60,
    "BackoffJitterFactor": 0.2,
    "AgentVersion": "1.0.0-phase1",
    "ProtocolVersion": "1.0",
    "LocalDataDirectory": "",
    "EnvironmentName": "Production",
    "TlsValidationMode": "SystemTrust",
    "PinnedCertificateThumbprint": ""
  }
}
